LAMMPS (2 Aug 2023 - Update 1)
# LAMMPS input file: values to test e.g. stress & pressure computations
units           lj
atom_style hybrid bond edpd
variable kb equal 1.0
comm_modify vel yes
special_bonds lj 1.0 1.0 1.0 coul 1.0 1.0 1.0
bond_style harmonic
newton on
neigh_modify every 1 delay 0 check yes one 5000
neighbor 6 bin

variable seed equal 23425

read_data ./melt_83_a_100.structure.out
Reading data file ...
  orthogonal box = (0 0 0) to (14.038443 14.038443 14.038443)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  8300 atoms
  scanning bonds ...
  1 = max bonds/atom
  reading bonds ...
  8217 bonds
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    1        1        1       
  special bond factors coul:  1        1        1       
     2 = max # of 1-2 neighbors
     2 = max # of special neighbors
  special bonds CPU = 0.005 seconds
  read_data CPU = 0.045 seconds

variable sigmaPaper equal 0
variable T equal 1.
variable gamma equal 0.5*${sigmaPaper}^2/(${kb}*${T})
variable gamma equal 0.5*0^2/(${kb}*${T})
variable gamma equal 0.5*0^2/(1*${T})
variable gamma equal 0.5*0^2/(1*1)
variable A equal 0.
variable cutoff equal 1.0
variable k equal 1. # 2.0

bond_coeff * ${k} 0.0
bond_coeff * 1 0.0

pair_style dpd ${T} ${cutoff} ${seed}
pair_style dpd 1 ${cutoff} ${seed}
pair_style dpd 1 1 ${seed}
pair_style dpd 1 1 23425
pair_coeff * * ${A} ${gamma}
pair_coeff * * 0 ${gamma}
pair_coeff * * 0 0

fix 1 all mvv/dpd 0.5
run_style verlet

timestep 0.06

# compute stresses
compute pA all pressure thermo_temp

compute 3 all temp/com
thermo_style    custom step temp vol dt press c_3 c_pA[1] c_pA[2] c_pA[3] c_pA[4] c_pA[5] c_pA[6]
thermo 1

run 75
