{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug C++ Header Tests",
      "cwd": "${workspaceFolder}/tests/build",
      "program": "${workspaceFolder}/tests/build/header_tests",
      "args": ["Box can compute bounding box"],
      "env": {
        "MallocNanoZone": "0",
        "ASAN_OPTIONS": "detect_leaks=0",
        // "ASAN_OPTIONS": "detect_leaks=1:detect_container_overflow=0:strict_string_checks=1:detect_stack_use_after_return=1:check_initialization_order=1:strict_init_order=1",
        "LSAN_OPTIONS": "suppressions=${workspaceFolder}/tests/lsan.supp"
      },
      "preLaunchTask": "Compile Tests"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug C++ Tests",
      "cwd": "${workspaceFolder}/tests/build",
      "program": "${workspaceFolder}/tests/build/pylimer_tests",
      "args": ["MEHP Force Balance Entanglement Links are just like Entanglement Springs"],
      "env": {
        "MallocNanoZone": "0",
        "ASAN_OPTIONS": "detect_leaks=0",
        // "ASAN_OPTIONS": "detect_leaks=1:detect_container_overflow=0:strict_string_checks=1:detect_stack_use_after_return=1:check_initialization_order=1:strict_init_order=1",
        "LSAN_OPTIONS": "suppressions=${workspaceFolder}/tests/lsan.supp"
      },
      "preLaunchTask": "Compile Tests"
    },
    {
      "type": "cppdbg",
      "request": "launch",
      "MIMode": "lldb",
      "name": "Debug Cpp Tests",
      "cwd": "${workspaceFolder}/tests/build",
      "program": "${workspaceFolder}/tests/build/pylimer_tests",
      "args": ["MEHP Force Balance Entanglement Beads Are Removed"],
      "environment": [
        {
          "name": "MallocNanoZone",
          "value": "0"
        },
        {
          "name": "ASAN_OPTIONS",
          "value": "detect_leaks=0"
        },
        {
          "name": "LSAN_OPTIONS",
          "value": "suppressions=${workspaceFolder}/tests/lsan.supp"
        }
      ],
      "preLaunchTask": "Compile Tests"
    },
    {
      "name": "(lldb) Cppdbg",
      "type": "cppdbg",
      "cwd": "${workspaceFolder}/src",
      "request": "attach",
      // "request": "launch",
      "processId": "${command:pickProcess}",
      "program": "/Users/timbernhard/.vscode/extensions/ms-vscode.cpptools-1.22.11-darwin-arm64/bin/cpptools",
      "MIMode": "lldb"
    }
  ]
}
