{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug C++ Tests",
      "cwd": "${workspaceFolder}/tests/build",
      "program": "${workspaceFolder}/tests/build/pylimer_tests",
      "args": [
        //"[MEHPForceBalance2]"
        "Universe generator uses correct w_sol even for strange structures"
      ],
      "env": {
        "MallocNanoZone": "0",
        "ASAN_OPTIONS": "detect_leaks=0",
        // "ASAN_OPTIONS": "detect_leaks=1:detect_container_overflow=0:strict_string_checks=1:detect_stack_use_after_return=1:check_initialization_order=1:strict_init_order=1",
        "LSAN_OPTIONS": "suppressions=${workspaceFolder}/tests/lsan.supp"
      },
      "preLaunchTask": "Compile Tests"
    },
    {
      "type": "cppdbg",
      "request": "launch",
      "MIMode": "lldb",
      "name": "Debug Cpp Tests",
      "cwd": "${workspaceFolder}/tests/build",
      "program": "${workspaceFolder}/tests/build/pylimer_tests",
      "args": ["[EigenNeighbourList]", "--skip-benchmarks"],
      "environment": [
        {
          "name": "MallocNanoZone",
          "value": "0"
        },
        {
          "name": "ASAN_OPTIONS",
          "value": "detect_leaks=0"
        },
        {
          "name": "LSAN_OPTIONS",
          "value": "suppressions=${workspaceFolder}/tests/lsan.supp"
        }
      ],
      "preLaunchTask": "Compile Tests"
    },
    {
      "name": "(lldb) Cppdbg",
      "type": "cppdbg",
      "cwd": "${workspaceFolder}/src",
      "request": "attach",
      // "request": "launch",
      "processId": "${command:pickProcess}",
      "program": "/Users/timbernhard/.vscode/extensions/ms-vscode.cpptools-1.22.11-darwin-arm64/bin/cpptools",
      "MIMode": "lldb"
    },
    {
      // debug python file with arguments
      "name": "Python: Current File with Arg",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "args": [
        // "/Users/timbernhard/Privat/Programming/OpenSource-Contributions/pylimer-tools/tests/pylimer_tools/fixtures/tmp/mc_own-si_pdms_crosslinked_melt_2590_a_221_2410_monoa_271_r_1.44_wsol_0.278_f_4_v_1.structure.out"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUNBUFFERED": "1"
      }
    }
  ]
}
