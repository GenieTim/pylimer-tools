{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Install package",
      "command": "python -m pip install ${workspaceFolder}"
    },
    {
      "type": "shell",
      "label": "Compile Tests",
      "command": "./bin/build-tests.sh",
      "options": {
        "env": {
          "DIABLE_COVERAGE": "1",
          "EP_UPDATE_DISCONNECTED": "1"
          // "PATH": "/opt/homebrew/opt/llvm/bin:$PATH",
          // "LDFLAGS": "-L/opt/homebrew/opt/llvm/lib/c++ -L/opt/homebrew/opt/llvm/lib -lunwind"
        }
      }
    }
  ]
}
